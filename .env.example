# API server
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/agromarket
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
CLERK_SECRET_KEY=sk_test_replace_with_your_key
CORS_ORIGINS=http://localhost:5173,https://replace-with-frontend-domain

# Frontend (export these before starting Vite)
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:3001
VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key

# Paystack Inline checkout; use test credentials during integration testing
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_key
